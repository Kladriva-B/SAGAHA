# Copie locale : .env.local — production : Doppler ou variables Vercel (ne pas committer de secrets).

# --- Base de données ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sagaha?schema=public"

# --- Auth (Doppler : aligner NEXTAUTH_SECRET et AUTH_SECRET sur la même valeur) ---
AUTH_SECRET="remplacer-par-une-valeur-longue-et-aleatoire"
NEXTAUTH_SECRET="meme-valeur-que-AUTH-secret-recommande"

# URLs canoniques (SEO, callbacks, emails)
NEXTAUTH_URL="https://votre-domaine.vercel.app"
AUTH_URL="https://votre-domaine.vercel.app"
NEXT_PUBLIC_SITE_URL="https://votre-domaine.vercel.app"

# --- Emails (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="SAGAHA <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL="admin@sagaha.cm"

# --- Médias ---
BLOB_READ_WRITE_TOKEN=""
# Optionnel (CDN) — ex. cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=""

# --- Monitoring (optionnel) ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# --- Webhooks ---
ORDER_STATUS_WEBHOOK_URL=""
