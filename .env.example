# Copie locale : .env.local — production : Doppler ou variables Vercel (ne pas committer de secrets).

# --- Base de données ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sagaha?schema=public"

# --- Docker local (PostgreSQL + app) ---
# Toute la stack : depuis la racine du projet `sagaha` →  docker compose up --build
# Puis : docker compose exec app npm run db:seed
# Uniquement Postgres (Next en local sur la machine) :
#   docker compose up -d postgres
#   Dans .env.local :
#   DATABASE_URL="postgresql://sagaha:sagaha@localhost:5432/sagaha?schema=public"
# Identifiants Postgres du compose : utilisateur sagaha / mot de passe sagaha / base sagaha
# Le service `app` du compose définit DOCKER_LOCAL_HTTP=1 pour que le cookie CSRF fonctionne en http://localhost (sans TLS).

# --- Auth (Doppler : aligner NEXTAUTH_SECRET et AUTH_SECRET sur la même valeur) ---
AUTH_SECRET="remplacer-par-une-valeur-longue-et-aleatoire"
NEXTAUTH_SECRET="meme-valeur-que-AUTH-secret-recommande"

# URLs canoniques (SEO, callbacks, emails)
NEXTAUTH_URL="https://votre-domaine.vercel.app"
AUTH_URL="https://votre-domaine.vercel.app"
NEXT_PUBLIC_SITE_URL="https://votre-domaine.vercel.app"

# --- Emails (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="SAGAHA <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL="admin@sagaha.cm"

# --- Médias ---
BLOB_READ_WRITE_TOKEN=""
# Optionnel (CDN) — ex. cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=""

# --- Monitoring (optionnel) ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# --- Webhooks ---
ORDER_STATUS_WEBHOOK_URL=""
ORDER_STATUS_WEBHOOK_SECRET=""

# --- Seed local ---
ADMIN_SEED_EMAIL="admin@sagaha.cm"
ADMIN_SEED_PASSWORD="ChangerCeMotDePasse123!"
MANAGER_SEED_EMAIL="manager@sagaha.cm"
MANAGER_SEED_PASSWORD="ChangerCeMotDePasse123!"
